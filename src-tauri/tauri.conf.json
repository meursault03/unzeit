{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unzeit",
  "version": "0.3.0",
  "identifier": "local.unzeit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Unzeit", "width": 1280, "height": 840, "minWidth": 720, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' http://127.0.0.1:*; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": { "active": true, "targets": ["appimage"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"], "category": "Education", "shortDescription": "Offline course library" }
}
