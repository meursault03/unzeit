{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["rpm"],
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "linux": {
      "rpm": {
        "release": "1",
        "desktopTemplate": "../packaging/Unzeit.desktop",
        "depends": [
          "webkit2gtk4.1", "gtk3", "gstreamer1-plugins-base",
          "gstreamer1-plugins-good", "gstreamer1-plugins-bad-free",
          "gstreamer1-plugin-libav", "/usr/bin/ffmpeg", "/usr/bin/ffprobe",
          "xdg-utils", "xdg-desktop-portal"
        ],
        "recommends": ["gstreamer1-plugin-openh264"],
        "files": {
          "/usr/share/metainfo/local.unzeit.desktop.metainfo.xml": "../packaging/local.unzeit.desktop.metainfo.xml",
          "/usr/share/licenses/unzeit/OFL.txt": "../public/fonts/OFL.txt",
          "/usr/share/licenses/unzeit/TRADEMARKS.txt": "../public/fonts/TRADEMARKS.txt"
        }
      }
    }
  }
}
